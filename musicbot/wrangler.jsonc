/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "musicbot",
	"main": "src/index.ts",
	"compatibility_date": "2026-05-08",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		// Vite emits the built SPA into ./public (see vite.config.ts).
		// The Hono Worker delegates non-/api requests to `env.ASSETS` (see
		// src/index.ts catch-all). `single-page-application` is what makes
		// env.ASSETS.fetch("/login") return /index.html so deep-links work.
		"directory": "./public",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application"
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "musicbot",
			"database_id": "ba01d12f-9be1-42bc-ae5a-7c7a3ec09ebd"
		}
	],
	"kv_namespaces": [
		{
			"binding": "SESSIONS",
			"id": "b00cc304974e4c5692ae64e3ed5ccb59"
		}
	],
	"vars": {
		// AI Gateway base URL. Create a gateway in the Cloudflare dashboard
		// (AI → AI Gateway → Create Gateway) and replace REPLACE_ME with its slug.
		// The worker appends provider paths (e.g. /google-ai-studio/v1beta/...) at call time.
		"AI_GATEWAY_BASE_URL": "https://gateway.ai.cloudflare.com/v1/5f0bf65365c8f6d076dbe0060a0810a1/REPLACE_ME"
	}
}