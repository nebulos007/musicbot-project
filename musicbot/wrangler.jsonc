/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "musicbot",
	"main": "src/index.ts",
	"compatibility_date": "2026-05-08",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		// Vite emits the built SPA into ./public (see vite.config.ts).
		// SPA fallback is handled by the Hono Worker (`app.notFound` in
		// src/index.ts), NOT by `not_found_handling` — the latter intercepts
		// browser navigations (Sec-Fetch-Mode: navigate) ahead of the Worker
		// and would hijack OAuth redirects like /api/auth/login.
		"directory": "./public",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "musicbot",
			"database_id": "ba01d12f-9be1-42bc-ae5a-7c7a3ec09ebd"
		}
	],
	"kv_namespaces": [
		{
			"binding": "SESSIONS",
			"id": "b00cc304974e4c5692ae64e3ed5ccb59"
		}
	],
	"vars": {
		// AI Gateway base URL — ends at the gateway slug ("musicbot"). The worker
		// appends the provider path (/google-ai-studio/v1/models/...) at call time.
		"AI_GATEWAY_BASE_URL": "https://gateway.ai.cloudflare.com/v1/5f0bf65365c8f6d076dbe0060a0810a1/musicbot"
	}
}