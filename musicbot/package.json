    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.6.2",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "happy-dom": "^15.11.7",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.5.2",
    "vite": "^7.3.3",
    "vitest": "~3.2.0",
    "wrangler": "^4.90.0"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "^2.2.0",
